# Copy this file to .env and fill in the key. Never commit .env.

# Your Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
# claude-sonnet-5-5 and claude-haiku-5-5 are cheaper and faster.
# CLAUDE_MODEL=claude-opus-5-5

# Complaint times in the CSV file are written in this time zone.
# Use a name from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIME_ZONE=Asia/Kolkata

# Where complaints are saved, relative to the server folder.
# COMPLAINTS_FILE=data/complaints.csv

# --- Django ---
# True for local development only. It shows detailed error pages and allows the
# server to start without DJANGO_SECRET_KEY.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is not True. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=

# Comma-separated host names this server may be reached at.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# How many complaints one network address may send (number/sec|min|hour|day).
# COMPLAINT_RATE_LIMIT=30/min
